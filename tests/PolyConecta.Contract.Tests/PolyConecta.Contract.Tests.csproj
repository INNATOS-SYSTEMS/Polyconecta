<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Suite de contrato bridge-v1 (CT-23, D-122): prueba solo por HTTP y no referencia al bridge ni a
    PolyConecta. Corre igual contra el simulador y contra el bridge real; la URL llega por
    BRIDGE_URL. Ver tests/PolyConecta.Contract.Tests/README.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Para el receptor de callbacks; es parte del runtime, no un proyecto de la solución. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>
</Project>
