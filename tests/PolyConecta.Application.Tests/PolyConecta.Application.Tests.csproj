<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Testcontainers.MsSql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Soporte compartido: SQL Server en contenedor y documento de prueba (research R-07). -->
    <Compile Include="..\Compartido\**\*.cs" Link="Compartido\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PolyConecta.Application\PolyConecta.Application.csproj" />
    <ProjectReference Include="..\..\PolyConecta.Infrastructure\PolyConecta.Infrastructure.csproj" />
  </ItemGroup>
</Project>
