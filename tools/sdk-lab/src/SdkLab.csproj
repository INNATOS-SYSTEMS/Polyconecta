<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SdkLab</RootNamespace>
    <AssemblyName>sdklab</AssemblyName>
    <!-- MGW_SDK.dll es Win32: el proceso DEBE ser x86 -->
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Microsoft.Data.SqlClient no soporta el modo de globalización invariante: debe quedar en false. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Se compila el MISMO interop que usa el bridge: probar otro sería probar otra cosa. -->
    <Compile Include="..\..\..\PolyConecta.Contpaq\Infrastructure\Sdk\ContpaqiSdkNative.cs" Link="Shared\ContpaqiSdkNative.cs" />
  </ItemGroup>

</Project>
