@inject NavigationManager Nav
@implements IDisposable

<header class="o_main_navbar">
    <div class="d-flex align-items-center gap-3">
        <button class="app-brand" @onclick="GoHome" title="Inicio">
            <i class="bi bi-grid-3x3-gap-fill fs-5"></i>
        </button>
        @if (!string.IsNullOrEmpty(CurrentModule.Name))
        {
            <span class="o_module_name">@CurrentModule.Name</span>
        }
        @if (CurrentModule.Items.Count > 1 || CurrentModule.Items.Any(i => i.Children != null))
        {
            <nav class="o_header_menu">
                @foreach (var item in CurrentModule.Items)
                {
                    if (item.Children == null)
                    {
                        <a href="@item.Route" class="@(IsActive(item.Route) ? "active" : "")">@item.Label</a>
                    }
                    else
                    {
                        var abierto = menuAbierto == item.Label;
                        <div class="o_header_dropdown">
                            <button type="button" class="@(item.Children.Any(c => IsActive(c.Route)) ? "active" : "")"
                                    @onclick="() => menuAbierto = abierto ? null : item.Label">
                                @item.Label
                            </button>
                            @if (abierto)
                            {
                                <div class="o_header_dropdown_menu">
                                    @foreach (var hijo in item.Children)
                                    {
                                        <a href="@hijo.Route" class="@(IsActive(hijo.Route) ? "active" : "")" @onclick="() => menuAbierto = null">@hijo.Label</a>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </nav>
        }
    </div>

    <div class="d-flex align-items-center gap-3">
        <i class="bi bi-bell fs-5" style="cursor:pointer; opacity:0.9;" title="Notificaciones"></i>
        <div class="d-flex align-items-center gap-2">
            <span class="small">Alejandro Porras</span>
            <i class="bi bi-person-circle fs-4"></i>
        </div>
    </div>
</header>

@code {
    private record MenuItem(string Label, string Route, List<MenuItem>? Children = null);
    private record ModuleInfo(string Name, List<MenuItem> Items);

    /// <summary>
    /// Inventario absorbe lo que era Logística: las operaciones de almacén cuelgan de un solo
    /// menú "Operaciones" y la existencia vive en "Inventario".
    /// </summary>
    private static readonly ModuleInfo Inventario = new("Inventario", new()
    {
        new("Inventario", "/inventario", new() { new("Inventario Actual", "/inventario") }),
        new("Operaciones", "/entregas", new()
        {
            new("Entrega", "/entregas"),
            new("Recolección", "/recolecciones"),
            new("Traslado", "/traslados"),
            new("Recepción", "/recepcion")
        })
    });

    private static readonly ModuleInfo Ventas = new("Ventas", new()
    {
        new("Pedidos", "/pedidos"), new("Inventario", "/ventas/inventario")
    });

    private static readonly ModuleInfo Fabricacion = new("Fabricación", new()
    {
        new("Fabricación", "/fabricacion"), new("Producción", "/captura-masiva"), new("Incidencias", "/incidencias")
    });

    private static readonly List<(string Prefix, ModuleInfo Info)> ModuleMap = new()
    {
        ("/pedidos", Ventas),
        ("/ventas", Ventas),
        ("/inventario", Inventario),
        ("/fabricacion", Fabricacion),
        ("/captura-masiva", Fabricacion),
        ("/incidencias", Fabricacion),
        ("/calidad", new("Calidad", new() { new("Calidad", "/calidad") })),
        ("/traslados", Inventario),
        ("/recepcion", Inventario),
        ("/recolecciones", Inventario),
        ("/entregas", Inventario),
    };

    private static readonly ModuleInfo Empty = new("", new());

    private ModuleInfo CurrentModule = Empty;
    private string? menuAbierto;

    protected override void OnInitialized()
    {
        UpdateModule();
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateModule();
        menuAbierto = null;
        InvokeAsync(StateHasChanged);
    }

    private void UpdateModule()
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        CurrentModule = ModuleMap.FirstOrDefault(m => path.StartsWith(m.Prefix, StringComparison.OrdinalIgnoreCase)).Info ?? Empty;
    }

    private bool IsActive(string route) => new Uri(Nav.Uri).AbsolutePath.StartsWith(route, StringComparison.OrdinalIgnoreCase);

    private void GoHome() => Nav.NavigateTo("/");

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
