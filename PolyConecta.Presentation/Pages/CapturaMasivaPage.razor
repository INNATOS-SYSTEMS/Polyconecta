@page "/captura-masiva"
@inject OperationalFlowState Flow
@inject NavigationManager NavManager
@implements IDisposable

<div class="o_control_panel">
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-outline-secondary btn-sm" disabled title="Fuera de alcance de esta demo"><i class="bi bi-file-earmark-excel me-1"></i> Importar</button>
        <OdooBreadcrumb Items="@(new List<OdooBreadcrumb.Crumb> { new("Producción") })" />
    </div>
    <OdooSearchPanel TItem="ManufacturingOrder"
                     View="@SearchViews.Fabricacion"
                     @bind-Texto="searchText"
                     @bind-FiltrosActivos="filtros" />
    <div class="d-flex align-items-center gap-2">
        <OdooViewSwitcher KanbanEnabled="false" />
    </div>
</div>

<div class="p-4">
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle bg-white shadow-sm">
            <thead class="table-light">
                <tr>
                    <th style="width:36px;"><input type="checkbox" class="form-check-input" @onchange="ToggleAll" /></th>
                    <th>Orden de fabricación</th><th>Producto</th><th>Estado</th><th>Pedido</th>
                    <th class="text-end">Cantidad</th><th>Unidad</th><th class="text-end">Producido</th>
                    @for (int i = 1; i <= MaxRollos; i++) { <th class="text-end o_rollo_col">R@(i)</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var of in FilteredOrders)
                {
                    <tr style="cursor:pointer;" class="@(selected.Contains(of.Folio) ? "table-active" : "")" @onclick='() => NavManager.NavigateTo($"/fabricacion/{of.Folio}")'>
                        <td @onclick:stopPropagation="true"><input type="checkbox" class="form-check-input" checked="@selected.Contains(of.Folio)" @onchange="() => ToggleOne(of.Folio)" /></td>
                        <td class="fw-semibold text-primary small">@of.Folio</td>
                        <td class="small">@of.Producto</td>
                        <td><span class="badge @StateBadgeClass(of.State)">@of.State</span></td>
                        <td class="small">@of.PedidoFolio</td>
                        <td class="text-end small">@of.Cantidad.ToString("N0")</td>
                        <td class="small">@of.Unidad</td>
                        <td class="text-end small fw-bold">@of.ProducidoTotal.ToString("N0")</td>
                        @for (int i = 0; i < MaxRollos; i++)
                        {
                            <td class="text-end small o_rollo_col">@(i < of.Produccion.Count ? of.Produccion[i].Real.ToString("N0") : "")</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <OdooPager Count="@FilteredOrders.Count" />
</div>

@code {
    private string searchText = "";
    private List<string> filtros = new();
    private readonly HashSet<string> selected = new();

    /// <summary>Columnas de captura de kg por rollo (R1..R15), fijas.</summary>
    private const int MaxRollos = 15;

    /// <summary>La captura masiva es exclusiva de produccion de Extrusion.</summary>
    private List<ManufacturingOrder> FilteredOrders => SearchViews.Fabricacion.Aplicar(
        Flow.ManufacturingOrders.Where(o => o.ProcessType == "Extrusion"), searchText, filtros);

    private static string StateBadgeClass(string state) => state switch
    {
        "En progreso" => "o_badge_progreso",
        "Planeado" => "o_badge_planeado",
        "Hecho" => "o_badge_hecho",
        _ => "badge-brand"
    };

    private void ToggleOne(string folio)
    {
        if (!selected.Remove(folio)) selected.Add(folio);
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        var check = e.Value is bool b && b;
        selected.Clear();
        if (check) foreach (var of in FilteredOrders) selected.Add(of.Folio);
    }

    protected override void OnInitialized() => Flow.OnChange += StateHasChanged;
    public void Dispose() => Flow.OnChange -= StateHasChanged;
}
