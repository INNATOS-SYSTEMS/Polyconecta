@page "/"
@inject NavigationManager Nav

<div class="o_app_hub">
    <div class="o_app_grid">
        @foreach (var app in Apps)
        {
            <button class="o_app_tile" @onclick="() => Nav.NavigateTo(app.Route)">
                <span class="o_app_icon" style="background:@app.Color;"><i class="bi @app.Icon"></i></span>
                <span class="o_app_label">@app.Label</span>
            </button>
        }
    </div>
</div>

@code {
    private record AppTile(string Label, string Icon, string Color, string Route);

    private static readonly List<AppTile> Apps = new()
    {
        new("Ventas", "bi-cart-check-fill", "#017E84", "/pedidos"),
        new("Fabricación", "bi-gear-wide-connected", "#2E3889", "/fabricacion"),
        new("Calidad", "bi-shield-check", "#2C7A4B", "/calidad"),
        new("Inventario", "bi-boxes", "#8A5A2B", "/inventario"),
    };
}
