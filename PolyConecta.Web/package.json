{
  "name": "polyconecta-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "verificar-build": "node scripts/verificar-build.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "scenarios": "playwright test --config e2e/playwright.config.ts scenarios/ --grep escenario",
    "audit": "playwright test --config e2e/playwright.config.ts auditoria/",
    "chatter": "playwright test --config e2e/chatter/playwright.config.ts",
    "tablero": "playwright test --config e2e/tablero/playwright.config.ts"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@microsoft/signalr": "10.0.11",
    "@spartan-ng/brain": "1.6.1",
    "@tanstack/angular-table": "9.2.6",
    "lucide": "1.52.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@playwright/test": "1.63.0",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
